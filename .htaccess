DirectoryIndex index.html index.php
Options -MultiViews -Indexes +SymLinksIfOwnerMatch
RewriteEngine On

# 0) Interne Systemordner (storage, includes, tools) und versteckte/DB-Dateien
#    strikt vor jedem direkten HTTP-Zugriff sperren (403 Forbidden)
RewriteRule ^(storage|includes|tools)(/|$) - [F,L]

<FilesMatch "(^\.(?!well-known)|\.(db|sqlite|sqlite3|wal|shm|py|sh|sql|env|log)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# 1) Redirect .html URLs to clean URLs (301 — gut für SEO und Bookmarks)
#    Beispiel: /de/kontakt.html → /de/kontakt
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# 2) Intern .html-Datei liefern wenn eine clean URL angefragt wird
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L,QSA]
